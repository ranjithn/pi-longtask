{
  "version": 1,
  "id": "my-campaign",
  "baseBranch": "main",
  "branchPrefix": "longtask/my-campaign",
  "remote": "origin",
  "worktreeRoot": "../.pi-longtask-worktrees",
  "decisions": "decisions.md",
  "infrastructure": "Do not restart or reconfigure shared services. Use isolated test databases, storage and synthetic data; never reset or migrate shared or production data.",
  "setup": [
    {
      "name": "Install dependencies (adapt to your project)",
      "command": [
        "npm",
        "ci"
      ],
      "timeoutSeconds": 900
    }
  ],
  "checks": [
    {
      "name": "Project tests (adapt to your project)",
      "command": [
        "npm",
        "test"
      ],
      "timeoutSeconds": 1800
    }
  ],
  "uiChecks": [
    {
      "name": "Browser acceptance (requires project Playwright configuration)",
      "command": [
        "npx",
        "--no-install",
        "playwright",
        "test"
      ],
      "timeoutSeconds": 1800
    }
  ],
  "cleanup": true,
  "workPackages": [
    {
      "id": "WP00",
      "file": "WP00.md"
    },
    {
      "id": "WP01",
      "file": "WP01.md"
    }
  ]
}
